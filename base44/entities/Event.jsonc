{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'événement"
    },
    "description": {
      "type": "string",
      "description": "Description courte"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "culte",
        "ejp",
        "formation",
        "rendez_vous",
        "reunion",
        "service",
        "special",
        "autre",
        "fij"
      ],
      "default": "ejp",
      "description": "Type d'événement"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Date"
    },
    "event_time": {
      "type": "string",
      "description": "Heure (ex: 15:00)"
    },
    "end_time": {
      "type": "string",
      "description": "Heure de fin (ex: 17:00)"
    },
    "location": {
      "type": "string",
      "description": "Lieu"
    },
    "meet_url": {
      "type": "string",
      "description": "Lien Google Meet de la réunion"
    },
    "image_url": {
      "type": "string",
      "description": "Image de l'événement"
    },
    "audience": {
      "type": "string",
      "enum": [
        "all_servants",
        "all_members",
        "fij_pilots",
        "leaders",
        "specific"
      ],
      "default": "all_servants",
      "description": "Audience concernée"
    },
    "presence_mode": {
      "type": "string",
      "enum": [
        "optional",
        "mandatory",
        "informative"
      ],
      "default": "optional",
      "description": "Mode de présence"
    },
    "is_featured": {
      "type": "boolean",
      "description": "Mettre en avant ?",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "description": "Visible sur la page ?",
      "default": true
    },
    "is_public": {
      "type": "boolean"
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "target_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recurrence_key": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "event_date"
  ]
}
