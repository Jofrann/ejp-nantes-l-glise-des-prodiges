{
  "name": "WelcomeMemberProfile",
  "type": "object",
  "properties": {
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement Accueil"
    },
    "user_id": {
      "type": "string",
      "description": "ID de l'utilisateur (User)"
    },
    "full_name": {
      "type": "string",
      "description": "Nom complet (d\u00e9normalis\u00e9)"
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "accueil_entree",
          "orientation",
          "placement",
          "informations",
          "nouveaux_visiteurs",
          "emargement",
          "responsable_accueil",
          "autre"
        ]
      },
      "description": "Fonctions Accueil (distinctes du role_in_dept organisationnel)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Profil Accueil actif"
    },
    "notes": {
      "type": "string",
      "description": "Notes internes non sensibles"
    }
  },
  "required": [
    "department_id",
    "user_id",
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}