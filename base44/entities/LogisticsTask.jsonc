{
  "name": "LogisticsTask",
  "type": "object",
  "properties": {
    "logistics_plan_id": {
      "type": "string",
      "description": "ID du LogisticsPlan"
    },
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement (scoping)"
    },
    "title": {
      "type": "string",
      "description": "Titre de la t\u00e2che"
    },
    "description": {
      "type": "string",
      "description": "Description courte"
    },
    "assigned_to": {
      "type": "string",
      "description": "ID de l'utilisateur assign\u00e9 (facultatif)"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Nom de l'assign\u00e9 (d\u00e9normalis\u00e9)"
    },
    "due_at": {
      "type": "string",
      "format": "date",
      "description": "Date d'\u00e9ch\u00e9ance (facultatif)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Priorit\u00e9 de la t\u00e2che"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done",
        "blocked"
      ],
      "default": "todo",
      "description": "Statut de la t\u00e2che"
    },
    "created_by": {
      "type": "string",
      "description": "ID du cr\u00e9ateur"
    }
  },
  "required": [
    "logistics_plan_id",
    "department_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}