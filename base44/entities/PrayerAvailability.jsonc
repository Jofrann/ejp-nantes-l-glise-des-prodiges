{
  "name": "PrayerAvailability",
  "type": "object",
  "properties": {
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement MPI"
    },
    "user_id": {
      "type": "string",
      "description": "ID du membre"
    },
    "full_name": {
      "type": "string",
      "description": "Nom complet (d\u00e9normalis\u00e9)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date concern\u00e9e"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "maybe"
      ],
      "default": "maybe",
      "description": "Disponibilit\u00e9 pour cette date"
    },
    "reason": {
      "type": "string",
      "description": "Motif court et non sensible"
    }
  },
  "required": [
    "department_id",
    "user_id",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}