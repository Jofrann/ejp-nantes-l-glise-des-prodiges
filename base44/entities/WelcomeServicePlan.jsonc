{
  "name": "WelcomeServicePlan",
  "type": "object",
  "properties": {
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement Accueil"
    },
    "event_id": {
      "type": "string",
      "description": "ID de l'Event global correspondant (optionnel)"
    },
    "title": {
      "type": "string",
      "description": "Titre du service d'accueil (ex: Culte EJP)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date du service"
    },
    "call_time": {
      "type": "string",
      "description": "Heure de pr\u00e9sence / appel (HH:MM)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "preparing",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Statut du plan d'accueil"
    },
    "instructions": {
      "type": "string",
      "description": "Consignes g\u00e9n\u00e9rales pour l'\u00e9quipe d'accueil"
    },
    "created_by": {
      "type": "string",
      "description": "ID du cr\u00e9ateur"
    }
  },
  "required": [
    "department_id",
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}