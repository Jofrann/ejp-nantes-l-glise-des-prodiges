{
  "name": "WelcomeAssignment",
  "type": "object",
  "properties": {
    "service_plan_id": {
      "type": "string",
      "description": "ID du WelcomeServicePlan"
    },
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement (scoping)"
    },
    "user_id": {
      "type": "string",
      "description": "ID du membre affect\u00e9"
    },
    "full_name": {
      "type": "string",
      "description": "Nom complet (d\u00e9normalis\u00e9)"
    },
    "position": {
      "type": "string",
      "enum": [
        "accueil_entree",
        "orientation",
        "placement",
        "informations",
        "nouveaux_visiteurs",
        "emargement",
        "responsable_accueil",
        "autre"
      ],
      "default": "accueil_entree",
      "description": "Poste d'accueil pour ce service"
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "confirmed",
        "declined",
        "replaced"
      ],
      "default": "assigned",
      "description": "Statut de l'affectation"
    },
    "notes": {
      "type": "string",
      "description": "Notes courtes"
    }
  },
  "required": [
    "service_plan_id",
    "department_id",
    "user_id",
    "position"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}