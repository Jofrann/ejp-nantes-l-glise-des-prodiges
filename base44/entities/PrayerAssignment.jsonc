{
  "name": "PrayerAssignment",
  "type": "object",
  "properties": {
    "schedule_id": {
      "type": "string",
      "description": "ID du PrayerSchedule"
    },
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement (scoping)"
    },
    "user_id": {
      "type": "string",
      "description": "ID du membre affect\u00e9"
    },
    "full_name": {
      "type": "string",
      "description": "Nom complet (d\u00e9normalis\u00e9)"
    },
    "role": {
      "type": "string",
      "enum": [
        "intercesseur",
        "leader",
        "animateur",
        "support",
        "autre"
      ],
      "default": "intercesseur",
      "description": "R\u00f4le pour ce temps de pri\u00e8re"
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "confirmed",
        "declined"
      ],
      "default": "assigned",
      "description": "Statut de l'affectation"
    },
    "notes": {
      "type": "string",
      "description": "Notes courtes"
    }
  },
  "required": [
    "schedule_id",
    "department_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}