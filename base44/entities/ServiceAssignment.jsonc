{
  "name": "ServiceAssignment",
  "type": "object",
  "properties": {
    "department_id": {
      "type": "string"
    },
    "service_plan_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "position": {
      "type": "string",
      "maxLength": 120
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "confirmed",
        "declined",
        "replaced",
        "cancelled"
      ],
      "default": "assigned"
    },
    "service_status": {
      "type": "string",
      "enum": [
        "not_recorded",
        "completed",
        "not_completed"
      ],
      "default": "not_recorded"
    }
  },
  "required": [
    "department_id",
    "service_plan_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
