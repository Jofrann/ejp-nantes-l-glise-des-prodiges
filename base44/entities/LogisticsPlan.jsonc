{
  "name": "LogisticsPlan",
  "type": "object",
  "properties": {
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement Intendance"
    },
    "event_id": {
      "type": "string",
      "description": "ID de l'Event global correspondant (optionnel)"
    },
    "title": {
      "type": "string",
      "description": "Titre du plan logistique (ex: Culte EJP)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date de l'\u00e9v\u00e9nement"
    },
    "setup_time": {
      "type": "string",
      "description": "Heure d'installation (HH:MM)"
    },
    "teardown_time": {
      "type": "string",
      "description": "Heure de rangement (HH:MM)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "preparing",
        "ready",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Statut du plan logistique"
    },
    "instructions": {
      "type": "string",
      "description": "Consignes g\u00e9n\u00e9rales"
    },
    "created_by": {
      "type": "string",
      "description": "ID du cr\u00e9ateur"
    }
  },
  "required": [
    "department_id",
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}