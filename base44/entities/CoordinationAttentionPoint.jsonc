{
  "name": "CoordinationAttentionPoint",
  "type": "object",
  "properties": {
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement Coordination (scoping)"
    },
    "title": {
      "type": "string",
      "description": "Titre du point d'attention"
    },
    "description": {
      "type": "string",
      "description": "Ce qui n\u00e9cessite l'attention et pourquoi (op\u00e9rationnel, non pastoral)"
    },
    "expected_action": {
      "type": "string",
      "description": "Action attendue (facultatif)"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "watch",
        "action",
        "urgent"
      ],
      "default": "watch",
      "description": "Niveau de s\u00e9v\u00e9rit\u00e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "description": "Statut du point d'attention"
    },
    "assigned_to": {
      "type": "string",
      "description": "ID du responsable (facultatif)"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Nom du responsable (d\u00e9normalis\u00e9)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\u00c9ch\u00e9ance (facultatif)"
    },
    "created_by": {
      "type": "string",
      "description": "ID du cr\u00e9ateur"
    },
    "resolved_at": {
      "type": "string",
      "format": "date",
      "description": "Date de r\u00e9solution (facultatif)"
    }
  },
  "required": [
    "department_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}