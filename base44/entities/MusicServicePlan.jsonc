{
  "name": "MusicServicePlan",
  "type": "object",
  "properties": {
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement Prodiges Musique"
    },
    "event_id": {
      "type": "string",
      "description": "ID de l'Event global correspondant (optionnel \u2014 ne pas dupliquer Event)"
    },
    "title": {
      "type": "string",
      "description": "Titre du service (ex: Culte EJP)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date du service"
    },
    "start_time": {
      "type": "string",
      "description": "Heure de d\u00e9but (HH:MM)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "preparing",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Statut du plan de service"
    },
    "notes": {
      "type": "string",
      "description": "Notes de pr\u00e9paration"
    }
  },
  "required": [
    "department_id",
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}