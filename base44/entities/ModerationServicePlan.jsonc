{
  "name": "ModerationServicePlan",
  "type": "object",
  "properties": {
    "department_id": {
      "type": "string",
      "description": "ID du d\u00e9partement Mod\u00e9ration"
    },
    "event_id": {
      "type": "string",
      "description": "ID de l'Event global correspondant (optionnel)"
    },
    "title": {
      "type": "string",
      "description": "Titre du service mod\u00e9r\u00e9 (ex: Culte EJP)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date du service"
    },
    "call_time": {
      "type": "string",
      "description": "Heure de pr\u00e9sence / appel (HH:MM)"
    },
    "moderator_user_id": {
      "type": "string",
      "description": "ID du mod\u00e9rateur principal"
    },
    "moderator_name": {
      "type": "string",
      "description": "Nom du mod\u00e9rateur (d\u00e9normalis\u00e9)"
    },
    "co_moderator_user_id": {
      "type": "string",
      "description": "ID du co-mod\u00e9rateur (facultatif)"
    },
    "co_moderator_name": {
      "type": "string",
      "description": "Nom du co-mod\u00e9rateur (d\u00e9normalis\u00e9)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "preparing",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Statut du plan de mod\u00e9ration"
    },
    "general_notes": {
      "type": "string",
      "description": "Notes g\u00e9n\u00e9rales pour la mod\u00e9ration"
    },
    "created_by": {
      "type": "string",
      "description": "ID du cr\u00e9ateur"
    }
  },
  "required": [
    "department_id",
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}