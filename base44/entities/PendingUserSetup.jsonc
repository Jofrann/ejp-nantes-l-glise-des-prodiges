{
  "name": "PendingUserSetup",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Adresse email utilis\u00e9e pour l'invitation (cl\u00e9 de rapprochement)"
    },
    "first_name": {
      "type": "string",
      "description": "Pr\u00e9nom \u00e0 appliquer"
    },
    "last_name": {
      "type": "string",
      "description": "Nom \u00e0 appliquer"
    },
    "phone": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone \u00e0 appliquer (facultatif)"
    },
    "internal_identifier": {
      "type": "string",
      "description": "Identifiant EJP g\u00e9n\u00e9r\u00e9 (ex: prenom@prodiges)"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Badges globaux \u00e0 attribuer"
    },
    "department_memberships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "department_id": {
            "type": "string"
          },
          "role_in_dept": {
            "type": "string"
          }
        }
      },
      "description": "Appartenances d\u00e9partementales \u00e0 cr\u00e9er"
    },
    "fij_assignment": {
      "type": "object",
      "properties": {
        "fij_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "description": "Assignation FIJ \u00e0 appliquer (facultatif)"
    },
    "applied": {
      "type": "boolean",
      "default": false,
      "description": "Indique si le profil en attente a \u00e9t\u00e9 appliqu\u00e9"
    },
    "applied_at": {
      "type": "string",
      "format": "date",
      "description": "Date d'application (facultatif)"
    },
    "created_by_name": {
      "type": "string",
      "description": "Nom de l'admin ayant lanc\u00e9 l'invitation"
    }
  },
  "required": [
    "email",
    "first_name",
    "last_name",
    "internal_identifier"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}